{
    "root": true,
    "env": {
        "browser": true,
        "jquery": true,
        "es2021": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
        "ecmaVersion": 2021,
        "sourceType": "script"
    },
    "rules": {
        "indent": ["error", 4, { "SwitchCase": 1 }],
        "quotes": ["error", "single", { "avoidEscape": true }],
        "semi": ["error", "always"],
        "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
        "no-console": "off",
        "no-empty": ["error", { "allowEmptyCatch": true }],
        "no-undef": "warn",
        "no-redeclare": "error",
        "prefer-const": "warn",
        "eqeqeq": ["warn", "smart"],
        "no-var": "off",
        "no-useless-escape": "off"
    },
    "globals": {
        "API": "readonly",
        "TPL": "readonly",
        "template": "readonly",
        "lightGallery": "readonly",
        "lazyload": "readonly",
        "initSidebar": "readonly",
        "lgZoom": "readonly",
        "lgAutoplay": "readonly",
        "lgComment": "readonly",
        "lgFullscreen": "readonly",
        "lgRotate": "readonly",
        "lgThumbnail": "readonly",
        "lgVideo": "readonly",
        "lgHash": "readonly",
        "emojis": "readonly",
        "emotionMap": "readonly",
        "parseEmoji": "readonly",
        "formatDate": "readonly",
        "formatString": "readonly",
        "replaceAll": "readonly",
        "getArrayIndex": "readonly",
        "removeArrayItem": "readonly",
        "QZone_Config": "readonly",
        "userInfo": "readonly",
        "messages": "readonly",
        "boardInfo": "readonly",
        "blogs": "readonly",
        "diaries": "readonly",
        "albums": "readonly",
        "videos": "readonly",
        "shares": "readonly",
        "visitorInfo": "readonly",
        "friends": "readonly",
        "albumId": "readonly",
        "targetYear": "readonly"
    },
    "ignorePatterns": ["docs/", "node_modules/", "**/json/*.js"]
}
